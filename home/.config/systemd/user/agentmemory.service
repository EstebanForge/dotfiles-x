[Unit]
Description=agentmemory memory server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/agentmemory-local
WorkingDirectory=%h
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
MemoryHigh=4G
MemoryMax=6G
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
